# ==============================================================================
# FRONTEND (PUBLIC — Safe for Vite build / GitHub Actions Variables)
# Leave empty in local development when frontend and backend share the same origin.
# ==============================================================================

# Public base URL of the deployed Render backend API (no trailing slash)
# Example: https://vey-rasha-api.onrender.com
VITE_API_BASE_URL=""

# Repository subpath for GitHub Pages (with leading and trailing slash, or "/" for user/custom domain)
# Example: /vey-rasha/
VITE_BASE_PATH="/"

# ==============================================================================
# BACKEND (PRIVATE — Configure ONLY in Render Environment Variables / Local .env)
# NEVER prefix any variable below with VITE_ or commit real values to GitHub.
# ==============================================================================

# Runtime environment ("development" locally, "production" on Render)
NODE_ENV="development"

# Port injected automatically by Render in production (defaults to 3000 locally)
PORT=3000

# Allowed frontend origin(s) for CORS & WebSockets (comma-separated for multiple domains)
# Use ONLY the scheme + host (no path or trailing slash).
# Example: https://your-username.github.io
FRONTEND_URL="http://localhost:3000"

# Long random secret used to sign customer session tokens (generate 64+ random hex chars)
SESSION_SECRET=""

# Private Owner Two-Device Security (server-side only; single-use initial enrollment codes)
# Generate two separate high-entropy random codes for Phone 1 and Phone 2
OWNER_ENROLLMENT_CODE_1=""
OWNER_ENROLLMENT_CODE_2=""

# Emergency backend-only recovery secret (used strictly via npm run owner:recover when both phones are lost)
OWNER_RECOVERY_SECRET=""

# Optional self-referential application URL (injected in AI Studio or set on Render)
APP_URL=""

# Optional Gemini API key (only needed if AI features are later enabled; keep server-side only)
GEMINI_API_KEY=""
