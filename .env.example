# ==============================================================================
# VEY RASHA — FRONTEND ENVIRONMENT VARIABLES (PUBLIC)
# Safe for Vite build, GitHub Actions Variables, GitHub Pages, and Capacitor.
# NEVER put service_role keys, database passwords, or OAuth client secrets here.
# ==============================================================================

# Supabase Project URL (Settings -> API -> Project URL)
VITE_SUPABASE_URL=""

# Supabase Publishable / Anon Key (Settings -> API -> Publishable / anon key)
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Repository subpath for GitHub Pages (with leading and trailing slash, or "/" for custom/user domain)
# Example: /vey-rasha/
VITE_BASE_PATH="/"

# Optional development-only guest bypass (ONLY active when import.meta.env.DEV is true)
# Keep "false" or unset in production builds.
VITE_DEV_GUEST_ACCESS="false"

# ==============================================================================
# SERVER-SIDE / EDGE FUNCTIONS SECRETS (NEVER expose to frontend or prefix VITE_)
# ==============================================================================
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
